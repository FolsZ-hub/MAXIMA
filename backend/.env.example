# =============================================================================
# MAXIMA RPG Backend - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Server Configuration ---
PORT=3000
NODE_ENV=development

# --- CORS Configuration ---
# Comma-separated list of allowed origins for Socket.IO and Express CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Firebase Admin SDK Configuration ---
# Option 1: Path to your Firebase service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Inline service account credentials (used if path is not set)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Firebase Database URL (optional, for Realtime Database) ---
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
